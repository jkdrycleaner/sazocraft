<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f2ec">
  <title>Sazocraft — Handmade, thoughtfully</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --paper: #f5f2ec;
      --ink: #202820;
      --muted: #72776d;
      --line: #d9d8cf;
      --green: #315e4b;
      --green-dark: #244738;
      --lime: #d3e16b;
      --clay: #c56c4b;
      --white: #fffefa;
      --serif: 'Playfair Display', Georgia, serif;
      --sans: 'DM Sans', sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); }
    button, input, textarea, select { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    a { color: inherit; text-decoration: none; }
    button { color: inherit; }
    .site-header { height: 78px; padding: 0 6.2vw; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(32, 40, 32, .12); }
    .wordmark { display: inline-flex; align-items: baseline; gap: 9px; font-size: 20px; font-weight: 700; letter-spacing: 0; }
    .wordmark small { color: var(--muted); font-size: 9px; font-weight: 600; letter-spacing: 0; }
    .main-nav { display: flex; align-items: center; gap: 36px; font-size: 12px; font-weight: 600; }
    .main-nav a:not(.admin-link):hover { color: var(--clay); }
    .header-actions { display: flex; align-items: center; gap: 22px; }
    .admin-link, .bag-button { border: 0; background: transparent; cursor: pointer; font-size: 12px; font-weight: 600; }
    .bag-button { display: flex; align-items: center; gap: 8px; }
    .bag-count { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid var(--line); border-radius: 50%; font-size: 10px; }

    .hero { position: relative; min-height: min(690px, calc(100svh - 78px)); overflow: hidden; display: flex; align-items: center; background: #526b57; color: white; }
    .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 54%; }
    .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(16, 34, 26, .72) 0%, rgba(16, 34, 26, .42) 43%, rgba(16, 34, 26, .03) 100%); }
    .hero-content { position: relative; z-index: 1; width: min(620px, 74vw); margin: 0 0 0 10vw; padding: 72px 0; animation: arrive .8s ease both; }
    .eyebrow { display: flex; align-items: center; gap: 11px; margin: 0 0 22px; color: var(--lime); font-size: 10px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
    .eyebrow::before { content: ''; width: 27px; height: 1px; background: currentColor; }
    .hero h1 { max-width: 640px; margin: 0; font-family: var(--serif); font-size: clamp(54px, 7vw, 92px); font-weight: 500; line-height: 1.02; letter-spacing: 0; }
    .hero-copy { max-width: 395px; margin: 22px 0 29px; color: rgba(255, 255, 255, .84); font-size: 14px; line-height: 1.8; }
    .button-primary { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 23px; padding: 0 19px; border: 0; background: var(--lime); color: var(--ink); cursor: pointer; font-size: 11px; font-weight: 700; transition: background .2s, transform .2s; }
    .button-primary:hover { transform: translateY(-2px); background: #e0ec87; }
    .button-arrow { font-size: 17px; line-height: 1; }
    .hero-index { position: absolute; z-index: 1; right: 6.2vw; bottom: 34px; color: rgba(255,255,255,.78); font-size: 10px; }

    .ticker { overflow: hidden; background: var(--lime); color: var(--ink); }
    .ticker-track { display: flex; width: max-content; align-items: center; gap: 27px; padding: 15px 0; animation: ticker 32s linear infinite; font-size: 10px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
    .ticker-track span:nth-child(even) { color: var(--green); font-size: 15px; }
    .section { padding: 105px 8vw; }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 40px; }
    .section-kicker { margin: 0 0 11px; color: var(--clay); font-size: 10px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
    .section h2 { margin: 0; font-family: var(--serif); font-size: clamp(34px, 4vw, 51px); font-weight: 500; line-height: 1.13; letter-spacing: 0; }
    .text-link { padding-bottom: 5px; border-bottom: 1px solid var(--ink); font-size: 11px; font-weight: 700; white-space: nowrap; }
    .product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
    .product-card { min-width: 0; animation: arrive .55s ease both; }
    .product-image-wrap { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: #e3e3d9; }
    .product-image { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
    .product-card:hover .product-image { transform: scale(1.045); }
    .product-tag { position: absolute; top: 13px; left: 13px; padding: 7px 9px; background: var(--white); font-size: 9px; font-weight: 700; }
    .product-info { display: flex; align-items: start; justify-content: space-between; gap: 10px; padding-top: 14px; }
    .product-info h3 { margin: 0; font-size: 12px; font-weight: 600; }
    .product-info p { margin: 6px 0 0; color: var(--muted); font-size: 10px; }
    .product-price { flex: 0 0 auto; font-size: 11px; font-weight: 700; }
    .add-button { display: flex; width: 32px; height: 32px; align-items: center; justify-content: center; margin-top: 10px; border: 1px solid var(--line); border-radius: 50%; background: transparent; cursor: pointer; font-size: 18px; transition: background .2s, color .2s; }
    .add-button:hover { border-color: var(--green); background: var(--green); color: white; }
    .empty-products { grid-column: 1 / -1; padding: 55px 20px; color: var(--muted); text-align: center; }

    .story { display: grid; grid-template-columns: 1fr 1fr; min-height: 540px; background: var(--green); color: white; }
    .story-image-wrap { min-height: 420px; overflow: hidden; }
    .story-image { display: block; width: 100%; height: 100%; object-fit: cover; }
    .story-copy { display: flex; flex-direction: column; align-items: start; justify-content: center; padding: 70px clamp(35px, 8vw, 120px); }
    .story-copy .section-kicker { color: var(--lime); }
    .story-copy h2 { max-width: 440px; margin: 0; font-family: var(--serif); font-size: clamp(37px, 4vw, 55px); font-weight: 500; line-height: 1.1; letter-spacing: 0; }
    .story-copy p:not(.section-kicker) { max-width: 430px; margin: 22px 0 27px; color: rgba(255,255,255,.77); font-size: 13px; line-height: 1.85; }
    .story-link { padding-bottom: 5px; border-bottom: 1px solid var(--lime); color: var(--lime); font-size: 11px; font-weight: 600; }
    .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding: 30px 8vw; background: #202820; color: white; font-size: 10px; }
    .site-footer p { margin: 0; color: rgba(255,255,255,.65); }
    .footer-links { display: flex; gap: 20px; }
    .toast { position: fixed; z-index: 20; right: 24px; bottom: 24px; padding: 14px 19px; background: var(--ink); color: white; font-size: 12px; box-shadow: 0 8px 28px rgba(0,0,0,.18); animation: arrive .2s ease both; }

    .admin-shell { min-height: calc(100svh - 78px); display: grid; grid-template-columns: 240px 1fr; }
    .admin-sidebar { padding: 35px 23px; border-right: 1px solid var(--line); background: #eeece5; }
    .admin-label { margin: 0 0 26px; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
    .admin-nav { display: grid; gap: 7px; }
    .admin-nav button, .back-link { display: flex; width: 100%; align-items: center; gap: 11px; padding: 12px 11px; border: 0; background: transparent; cursor: pointer; text-align: left; font-size: 11px; font-weight: 600; }
    .admin-nav button.active { background: var(--green); color: white; }
    .admin-nav button span { display: grid; width: 20px; height: 20px; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-size: 10px; }
    .back-link { margin-top: 35px; color: var(--muted); }
    .admin-main { width: min(100%, 1100px); padding: 49px clamp(24px, 5vw, 76px) 80px; }
    .admin-topline { display: flex; align-items: start; justify-content: space-between; gap: 20px; margin-bottom: 34px; }
    .admin-topline h1 { margin: 0; font-family: var(--serif); font-size: 38px; font-weight: 500; letter-spacing: 0; }
    .admin-topline p { margin: 9px 0 0; color: var(--muted); font-size: 12px; }
    .save-status { align-self: center; color: var(--green); font-size: 10px; font-weight: 600; }
    .editor { max-width: 760px; }
    .editor-section { margin: 0 0 34px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
    .editor-section h2 { margin: 0 0 21px; font-size: 12px; font-weight: 700; }
    .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 20px; }
    .field { display: grid; gap: 8px; }
    .field.full { grid-column: 1 / -1; }
    .field label { color: #53594f; font-size: 10px; font-weight: 600; }
    .field input, .field textarea, .field select { width: 100%; min-height: 42px; padding: 11px 12px; border: 1px solid #cecec4; border-radius: 0; outline: 0; background: var(--white); color: var(--ink); font-size: 12px; }
    .field textarea { min-height: 100px; resize: vertical; line-height: 1.6; }
    .field input:focus, .field textarea:focus, .field select:focus { border-color: var(--green); box-shadow: 0 0 0 2px rgba(49,94,75,.1); }
    .admin-submit { min-height: 43px; padding: 0 18px; border: 0; background: var(--green); color: white; cursor: pointer; font-size: 11px; font-weight: 700; }
    .admin-submit:hover { background: var(--green-dark); }
    .product-admin-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
    .product-admin-head h2 { margin: 0; font-size: 12px; }
    .product-picker { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 23px; }
    .picker-button { min-height: 34px; padding: 0 11px; border: 1px solid var(--line); background: transparent; cursor: pointer; font-size: 10px; }
    .picker-button.active { border-color: var(--green); background: var(--white); color: var(--green); font-weight: 700; }
    .subtle-button { min-height: 36px; padding: 0 12px; border: 1px solid var(--line); background: transparent; cursor: pointer; font-size: 10px; font-weight: 700; }
    .subtle-button:hover { border-color: var(--green); color: var(--green); }
    .delete-button { margin-left: 12px; border: 0; background: transparent; color: #a34d39; cursor: pointer; font-size: 10px; font-weight: 700; }
    .admin-empty { padding: 35px 0; color: var(--muted); font-size: 12px; }
    .storage-note { margin-top: 36px; padding: 14px 16px; border-left: 2px solid var(--clay); background: #eeece5; color: var(--muted); font-size: 10px; line-height: 1.7; }

    @keyframes arrive { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes ticker { to { transform: translateX(-50%); } }
    @media (max-width: 900px) {
      .site-header { padding: 0 4vw; }
      .main-nav { gap: 20px; }
      .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 18px; }
      .section { padding: 80px 6vw; }
      .story-copy { padding: 55px 6vw; }
      .admin-shell { grid-template-columns: 195px 1fr; }
    }
    @media (max-width: 620px) {
      .site-header { height: 67px; padding: 0 18px; }
      .wordmark { font-size: 17px; }
      .wordmark small, .main-nav { display: none; }
      .header-actions { gap: 15px; }
      .hero { min-height: 640px; min-height: min(740px, calc(100svh - 67px)); align-items: end; }
      .hero-image { object-position: 59% center; }
      .hero::after { background: linear-gradient(0deg, rgba(16,34,26,.79) 0%, rgba(16,34,26,.37) 56%, rgba(16,34,26,.05) 100%); }
      .hero-content { width: auto; margin: 0; padding: 0 25px 78px; }
      .hero h1 { max-width: 440px; font-size: clamp(50px, 14vw, 74px); }
      .hero-copy { max-width: 330px; font-size: 13px; }
      .hero-index { right: 22px; bottom: 22px; }
      .section { padding: 67px 21px; }
      .section-heading { align-items: start; flex-direction: column; margin-bottom: 26px; }
      .section h2 { font-size: 38px; }
      .product-grid { gap: 27px 12px; }
      .product-info { flex-wrap: wrap; }
      .product-info h3 { font-size: 11px; }
      .product-info p { font-size: 9px; }
      .product-price { font-size: 10px; }
      .story { grid-template-columns: 1fr; }
      .story-image-wrap { min-height: 330px; max-height: 420px; }
      .story-copy { padding: 54px 25px 62px; }
      .site-footer { align-items: start; flex-direction: column; padding: 28px 22px; }
      .admin-link { font-size: 11px; }
      .admin-shell { display: block; min-height: calc(100svh - 67px); }
      .admin-sidebar { padding: 12px 16px; border-right: 0; border-bottom: 1px solid var(--line); }
      .admin-label, .back-link { display: none; }
      .admin-nav { grid-template-columns: 1fr 1fr; }
      .admin-nav button { justify-content: center; padding: 9px 5px; font-size: 10px; }
      .admin-main { padding: 31px 20px 55px; }
      .admin-topline { margin-bottom: 27px; }
      .admin-topline h1 { font-size: 32px; }
      .field-grid { grid-template-columns: 1fr; }
      .field.full { grid-column: auto; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <div id="app"></div>
  <script>
    const defaultContent = {
      heroEyebrow: 'Made slowly. Kept forever.',
      heroTitle: 'Objects with a softer story.',
      heroCopy: 'Thoughtful pieces for the corners you call home. Shaped by hand, made to be lived with.',
      heroImage: 'https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?auto=format&fit=crop&w=2200&q=88',
      storyTitle: 'Good things take the time they take.',
      storyCopy: 'We work with independent makers who bring patience, skill and a little bit of themselves to every piece. Small batches, natural materials, no two quite alike.',
      storyImage: 'https://images.unsplash.com/photo-1603006905003-be475563bc59?auto=format&fit=crop&w=1200&q=85',
      products: [
        { id: 'p1', name: 'Sunday Stoneware Vase', category: 'Ceramics', price: 48, description: 'Hand-thrown stoneware', image: 'https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?auto=format&fit=crop&w=900&q=85', tag: 'Small batch' },
        { id: 'p2', name: 'Woven Table Runner', category: 'Textiles', price: 64, description: 'Loom-woven cotton', image: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=900&q=85', tag: 'Natural dye' },
        { id: 'p3', name: 'Quiet Hour Candle', category: 'Home fragrance', price: 32, description: 'Poured by hand', image: 'https://images.unsplash.com/photo-1603006905003-be475563bc59?auto=format&fit=crop&w=900&q=85', tag: 'Best seller' },
        { id: 'p4', name: 'Everyday Clay Bowl', category: 'Ceramics', price: 38, description: 'Made for daily rituals', image: 'https://images.unsplash.com/photo-1490312278390-ab64016e0aa9?auto=format&fit=crop&w=900&q=85', tag: 'One of a kind' }
      ]
    };

    const storageKey = 'sazocraft-content-v1';
    let content = loadContent();
    let selectedProductId = content.products[0]?.id ?? null;
    let adminTab = 'home';
    let currentView = null;
    let bagCount = 0;
    let toastTimer;

    function loadContent() {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey));
        if (!saved || typeof saved !== 'object') return structuredClone(defaultContent);
        return {
          ...structuredClone(defaultContent),
          ...saved,
          products: Array.isArray(saved.products) ? saved.products : structuredClone(defaultContent.products)
        };
      } catch {
        return structuredClone(defaultContent);
      }
    }

    function persistContent() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(content));
        return true;
      } catch {
        showToast('Save nahi hua. Browser storage available nahi hai.');
        return false;
      }
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
    }

    function safeImageUrl(value) {
      try {
        const url = new URL(value, window.location.href);
        return ['https:', 'http:'].includes(url.protocol) ? url.href : '';
      } catch {
        return '';
      }
    }

    function money(value) {
      const amount = Number(value) || 0;
      return new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(amount);
    }

    function renderHeader(isAdmin) {
      return `<header class="site-header">
        <a class="wordmark" href="#shop" aria-label="Sazocraft home">SAZOCRAFT <small>HANDMADE, THOUGHTFULLY</small></a>
        ${isAdmin ? '' : `<nav class="main-nav" aria-label="Main navigation"><a href="#collection">Shop</a><a href="#story">Our story</a><a href="#story">The makers</a></nav>`}
        <div class="header-actions">
          ${isAdmin ? `<a class="admin-link" href="#shop">← Storefront</a>` : `<a class="admin-link" href="#admin">Admin</a><button class="bag-button" type="button" aria-label="Shopping bag, ${bagCount} items">Bag <span class="bag-count">${bagCount}</span></button>`}
        </div>
      </header>`;
    }

    function renderShop() {
      const products = content.products.map((product, index) => `<article class="product-card" style="animation-delay:${Math.min(index * 70, 280)}ms">
        <div class="product-image-wrap">
          ${safeImageUrl(product.image) ? `<img class="product-image" src="${escapeHtml(safeImageUrl(product.image))}" alt="${escapeHtml(product.name)}" loading="lazy">` : ''}
          ${product.tag ? `<span class="product-tag">${escapeHtml(product.tag)}</span>` : ''}
        </div>
        <div class="product-info"><div><h3>${escapeHtml(product.name)}</h3><p>${escapeHtml(product.description || product.category || '')}</p></div><span class="product-price">${money(product.price)}</span></div>
        <button class="add-button" type="button" data-add="${escapeHtml(product.id)}" aria-label="Add ${escapeHtml(product.name)} to bag" title="Add to bag">+</button>
      </article>`).join('');

      document.getElementById('app').innerHTML = `${renderHeader(false)}
        <main id="shop">
          <section class="hero" aria-labelledby="hero-title">
            ${safeImageUrl(content.heroImage) ? `<img class="hero-image" src="${escapeHtml(safeImageUrl(content.heroImage))}" alt="Handcrafted objects made by independent artisans">` : ''}
            <div class="hero-content"><p class="eyebrow">${escapeHtml(content.heroEyebrow)}</p><h1 id="hero-title">${escapeHtml(content.heroTitle)}</h1><p class="hero-copy">${escapeHtml(content.heroCopy)}</p><a class="button-primary" href="#collection">Explore the collection <span class="button-arrow" aria-hidden="true">→</span></a></div>
            <span class="hero-index">01 / MADE BY HAND, EVERY DAY</span>
          </section>
          <div class="ticker" aria-hidden="true"><div class="ticker-track">${Array.from({ length: 2 }, () => '<span>Made by hand</span><span>✳</span><span>Kept for years</span><span>✳</span><span>Made in small batches</span><span>✳</span><span>Made by hand</span><span>✳</span>').join('')}</div></div>
          <section class="section" id="collection">
            <div class="section-heading"><div><p class="section-kicker">Objects for everyday living</p><h2>Made to find a place.</h2></div><a class="text-link" href="#story">A little about us&nbsp; ↗</a></div>
            <div class="product-grid">${products || '<p class="empty-products">Our next small batch is on its way.</p>'}</div>
          </section>
          <section class="story" id="story">
            <div class="story-image-wrap">${safeImageUrl(content.storyImage) ? `<img class="story-image" src="${escapeHtml(safeImageUrl(content.storyImage))}" alt="A close view of a handmade object in a maker’s studio" loading="lazy">` : ''}</div>
            <div class="story-copy"><p class="section-kicker">Made with intention</p><h2>${escapeHtml(content.storyTitle)}</h2><p>${escapeHtml(content.storyCopy)}</p><a class="story-link" href="#collection">Meet your next favourite&nbsp; ↗</a></div>
          </section>
        </main>
        <footer class="site-footer"><a class="wordmark" href="#shop">SAZOCRAFT</a><p>Thoughtfully made. Ready for home.</p><div class="footer-links"><a href="#collection">Shop</a><a href="#story">Our story</a></div></footer>`;
    }

    function adminLayout(title, subtitle, panel) {
      document.getElementById('app').innerHTML = `${renderHeader(true)}<div class="admin-shell">
        <aside class="admin-sidebar"><p class="admin-label">Content manager</p><nav class="admin-nav" aria-label="Admin sections">
          <button type="button" data-tab="home" class="${adminTab === 'home' ? 'active' : ''}"><span>⌂</span> Home page</button>
          <button type="button" data-tab="products" class="${adminTab === 'products' ? 'active' : ''}"><span>＋</span> Products</button>
        </nav><a class="back-link" href="#shop">←&nbsp; View storefront</a></aside>
        <main class="admin-main"><div class="admin-topline"><div><h1>${title}</h1><p>${subtitle}</p></div><span class="save-status" id="save-status"></span></div>${panel}
          <p class="storage-note">Yahan save kiye gaye changes isi browser mein dikhte hain. Live website par sab visitors ko update dikhane ke liye baad mein server/database aur admin login jodna hoga.</p>
        </main>
      </div>`;
    }

    function renderHomeEditor() {
      const panel = `<form id="home-form" class="editor">
        <section class="editor-section"><h2>Hero section</h2><div class="field-grid">
          <div class="field full"><label for="hero-eyebrow">Chhota heading</label><input id="hero-eyebrow" name="heroEyebrow" value="${escapeHtml(content.heroEyebrow)}" required></div>
          <div class="field full"><label for="hero-title-input">Main heading</label><input id="hero-title-input" name="heroTitle" value="${escapeHtml(content.heroTitle)}" required></div>
          <div class="field full"><label for="hero-copy-input">Description</label><textarea id="hero-copy-input" name="heroCopy" required>${escapeHtml(content.heroCopy)}</textarea></div>
          <div class="field full"><label for="hero-image-input">Hero image URL</label><input id="hero-image-input" name="heroImage" type="url" value="${escapeHtml(content.heroImage)}" placeholder="https://..."></div>
        </div></section>
        <section class="editor-section"><h2>Our story section</h2><div class="field-grid">
          <div class="field full"><label for="story-title-input">Heading</label><input id="story-title-input" name="storyTitle" value="${escapeHtml(content.storyTitle)}" required></div>
          <div class="field full"><label for="story-copy-input">Description</label><textarea id="story-copy-input" name="storyCopy" required>${escapeHtml(content.storyCopy)}</textarea></div>
          <div class="field full"><label for="story-image-input">Story image URL</label><input id="story-image-input" name="storyImage" type="url" value="${escapeHtml(content.storyImage)}" placeholder="https://..."></div>
        </div></section>
        <button class="admin-submit" type="submit">Changes save karein</button>
      </form>`;
      adminLayout('Home page', 'Storefront ke main text aur images update karein.', panel);
    }

    function renderProductEditor() {
      const selected = content.products.find(product => product.id === selectedProductId);
      const panel = `<section class="editor">
        <div class="product-admin-head"><h2>Aapke products (${content.products.length})</h2><button class="subtle-button" type="button" data-add-product>+ Naya product</button></div>
        <div class="product-picker">${content.products.map(product => `<button class="picker-button ${product.id === selectedProductId ? 'active' : ''}" type="button" data-select-product="${escapeHtml(product.id)}">${escapeHtml(product.name || 'Naya product')}</button>`).join('')}</div>
        ${selected ? `<form id="product-form">
          <section class="editor-section"><div class="field-grid">
            <div class="field"><label for="product-name">Product name</label><input id="product-name" name="name" value="${escapeHtml(selected.name)}" required></div>
            <div class="field"><label for="product-category">Category</label><input id="product-category" name="category" value="${escapeHtml(selected.category)}"></div>
            <div class="field"><label for="product-price">Price (₹)</label><input id="product-price" name="price" type="number" min="0" step="1" value="${escapeHtml(selected.price)}" required></div>
            <div class="field"><label for="product-tag">Label</label><input id="product-tag" name="tag" value="${escapeHtml(selected.tag)}" placeholder="Small batch"></div>
            <div class="field full"><label for="product-description">Short description</label><textarea id="product-description" name="description">${escapeHtml(selected.description)}</textarea></div>
            <div class="field full"><label for="product-image">Image URL</label><input id="product-image" name="image" type="url" value="${escapeHtml(selected.image)}" placeholder="https://..."></div>
          </div></section>
          <button class="admin-submit" type="submit">Product save karein</button><button class="delete-button" type="button" data-delete-product="${escapeHtml(selected.id)}">Product delete karein</button>
        </form>` : `<p class="admin-empty">Abhi koi product nahi hai. Naya product jodne ke liye upar click karein.</p>`}
      </section>`;
      adminLayout('Products', 'Products ko add, edit ya remove karein.', panel);
    }

    function renderAdmin() {
      if (adminTab === 'products') renderProductEditor();
      else renderHomeEditor();
    }

    function renderApp() {
      const nextView = window.location.hash === '#admin' ? 'admin' : 'shop';
      if (nextView === currentView) return;
      currentView = nextView;
      if (currentView === 'admin') renderAdmin();
      else renderShop();
    }

    function showToast(message) {
      document.querySelector('.toast')?.remove();
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.setAttribute('role', 'status');
      toast.textContent = message;
      document.body.append(toast);
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.remove(), 2600);
    }

    document.addEventListener('click', event => {
      const addButton = event.target.closest('[data-add]');
      if (addButton) {
        bagCount += 1;
        const count = document.querySelector('.bag-count');
        if (count) count.textContent = bagCount;
        const bag = document.querySelector('.bag-button');
        if (bag) bag.setAttribute('aria-label', `Shopping bag, ${bagCount} items`);
        showToast('Aapke bag mein add ho gaya.');
        return;
      }

      const tabButton = event.target.closest('[data-tab]');
      if (tabButton) {
        adminTab = tabButton.dataset.tab;
        renderAdmin();
      }

      const productButton = event.target.closest('[data-select-product]');
      if (productButton) {
        selectedProductId = productButton.dataset.selectProduct;
        renderProductEditor();
      }

      if (event.target.closest('[data-add-product]')) {
        const product = { id: `p-${Date.now()}`, name: 'Naya handmade product', category: '', price: 0, description: '', image: '', tag: '' };
        content.products.push(product);
        selectedProductId = product.id;
        persistContent();
        renderProductEditor();
        document.getElementById('product-name')?.focus();
      }

      const deleteButton = event.target.closest('[data-delete-product]');
      if (deleteButton) {
        content.products = content.products.filter(product => product.id !== deleteButton.dataset.deleteProduct);
        selectedProductId = content.products[0]?.id ?? null;
        persistContent();
        renderProductEditor();
        showToast('Product delete ho gaya.');
      }
    });

    document.addEventListener('submit', event => {
      if (event.target.id === 'home-form') {
        event.preventDefault();
        const values = Object.fromEntries(new FormData(event.target));
        Object.assign(content, values);
        if (persistContent()) {
          const status = document.getElementById('save-status');
          if (status) status.textContent = 'Saved';
          showToast('Home page update ho gaya.');
        }
      }

      if (event.target.id === 'product-form') {
        event.preventDefault();
        const values = Object.fromEntries(new FormData(event.target));
        const product = content.products.find(item => item.id === selectedProductId);
        if (!product) return;
        Object.assign(product, values, { price: Math.max(0, Number(values.price) || 0) });
        if (persistContent()) {
          const status = document.getElementById('save-status');
          if (status) status.textContent = 'Saved';
          showToast('Product update ho gaya.');
        }
      }
    });

    window.addEventListener('hashchange', renderApp);
    renderApp();
  </script>
</body>
</html>
